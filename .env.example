# From your app on https://developer.spotify.com/dashboard
VITE_SPOTIFY_CLIENT_ID=your_client_id_here

# Optional. Defaults to the site's own address with a trailing slash,
# e.g. http://127.0.0.1:5173/ locally or https://your-app.vercel.app/ once deployed.
# Whatever it ends up being must be listed exactly under Redirect URIs in the dashboard.
# VITE_REDIRECT_URI=
